# The tests: Equinox with the test bundle, the headless part of MAT, Felix SCR and JUnit 4 (see mat-calcite-mcp.bndrun)
-runfw: org.eclipse.osgi
-runee: JavaSE-17
-tester: biz.aQute.tester
-runrequires: \
    bnd.identity;id='io.github.miguelnieto.matcalcitemcp.tests',\
    bnd.identity;id='org.eclipse.mat.parser',\
    bnd.identity;id='org.eclipse.mat.hprof',\
    bnd.identity;id='org.eclipse.equinox.registry',\
    bnd.identity;id='org.eclipse.core.runtime',\
    bnd.identity;id='org.apache.felix.scr',\
    bnd.identity;id='org.junit'

# The tests open dumps/mvn1m_jdk18.hprof next to this file; MAT's preferences go to build/
-runproperties: \
    osgi.framework.useSystemProperties=true,\
    osgi.instance.area=${.}/build/test-workspace,\
    test.dumps=${.}/dumps
-runbundles: \
	org.junit;version='[4.13.2,4.13.3)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.service.prefs;version='[1.1.2,1.1.3)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	com.sun.jna;version='[5.18.1,5.18.2)',\
	com.sun.jna.platform;version='[5.18.1,5.18.2)',\
	org.apache.felix.scr;version='[2.2.18,2.2.19)',\
	org.eclipse.core.commands;version='[3.12.500,3.12.501)',\
	org.eclipse.core.contenttype;version='[3.9.800,3.9.801)',\
	org.eclipse.core.expressions;version='[3.9.600,3.9.601)',\
	org.eclipse.core.filesystem;version='[1.11.400,1.11.401)',\
	org.eclipse.core.jobs;version='[3.15.800,3.15.801)',\
	org.eclipse.core.resources;version='[3.24.0,3.24.1)',\
	org.eclipse.core.runtime;version='[3.34.200,3.34.201)',\
	org.eclipse.equinox.app;version='[1.7.600,1.7.601)',\
	org.eclipse.equinox.common;version='[3.20.400,3.20.401)',\
	org.eclipse.equinox.preferences;version='[3.12.100,3.12.101)',\
	org.eclipse.equinox.registry;version='[3.12.600,3.12.601)',\
	org.eclipse.mat.api;version='[1.17.0,1.17.1)',\
	org.eclipse.mat.hprof;version='[1.17.0,1.17.1)',\
	org.eclipse.mat.parser;version='[1.17.0,1.17.1)',\
	org.eclipse.mat.report;version='[1.17.0,1.17.1)',\
	org.hamcrest;version='[3.0.0,3.0.1)',\
	io.github.miguelnieto.matcalcitemcp.tests;version='[0.2.0,0.2.1)'